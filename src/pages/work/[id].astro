---
import Base from "../../layouts/Base.astro";
import Flow from "../../components/Flow.astro";
import BugChart from "../../components/BugChart.astro";
import BugReplay from "../../components/BugReplay.astro";
import AwardBadge from "../../components/AwardBadge.astro";
import StackChips from "../../components/StackChips.astro";
import CodeExcerpt from "../../components/CodeExcerpt.astro";
import AuthDemo from "../../components/AuthDemo.astro";
import LiveStatus from "../../components/LiveStatus.astro";
import Prompt from "../../components/Prompt.astro";
import Screenshot from "../../components/Screenshot.astro";
import RepoStats from "../../components/RepoStats.astro";
import { projects, type Project } from "../../lib/data";
import { projectShots } from "../../lib/shots";

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

interface Props {
  project: Project;
  prev: Project;
  next: Project;
}

const { project, prev, next } = Astro.props;
const { caseStudy } = project;
---

<Base title={`${project.title}, Aly Sibak`} description={project.tagline}>
  <article class="mx-auto max-w-xl">
    <a href="/work" class="meta link text-subtle">cd ..<span class="sr-only"> (all work)</span></a>

    <Prompt path="~/work" cmd={`cat ${project.id}.md`} class="mt-8" />
    <header class="mt-3">
      <div class="flex items-baseline justify-between gap-4">
        <h1 class="md-h1"><span class="inline-block" transition:name={`project-${project.id}`}>{project.title}</span></h1>
        {project.year && <span class="meta shrink-0 tabular-nums text-subtle">{project.year}</span>}
      </div>
      <p class="mt-2 text-[1.0625rem] leading-relaxed text-muted">{project.tagline}</p>
      <p class="meta mt-1 text-subtle">{project.context}</p>
      <div class="meta mt-4 flex flex-wrap items-center gap-x-4 gap-y-1">
        {
          project.links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[link.label === "Live" || link.label === "Devpost" ? "link-accent" : "link"]}
            >
              {link.label.toLowerCase()}
              <span class="sr-only"> (opens in a new tab)</span>
              <span aria-hidden="true"> ↗</span>
            </a>
          ))
        }
        <LiveStatus project={project} />
      </div>
      <div class="mt-5">
        <StackChips stack={project.stack} />
      </div>
      <RepoStats id={project.id} />
    </header>

    {
      projectShots[project.id] && (
        <div class="wide mt-10">
          <Screenshot project={project} eager sizes="(min-width: 51rem) 48rem, calc(100vw - 3rem)" />
        </div>
      )
    }

    <section class="mt-12">
      <h2 class="md-h2">How it fits together</h2>
      <Flow project={project} />
      {
        project.ownership && (
          <p class="ownership meta mt-4 leading-relaxed text-muted">
            <span class="text-subtle">What I owned </span>
            {project.ownership}
          </p>
        )
      }
      {project.award && <AwardBadge award={project.award} />}
    </section>

    {
      project.finding && (
        <section class="mt-10 border-t border-border pt-8">
          <h2 class="md-h2">The bug</h2>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{project.finding}</p>
          {project.findingChart && <BugChart chart={project.findingChart} />}
          {project.id === "carinfo" && <BugReplay />}
        </section>
      )
    }

    {
      project.id === "timevault" && (
        <section class="mt-10 border-t border-border pt-8">
          <h2 class="md-h2">Try it</h2>
          <AuthDemo />
        </section>
      )
    }

    {
      project.code && (
        <section class="mt-10 border-t border-border pt-8">
          <h2 class="md-h2">The code</h2>
          <CodeExcerpt excerpt={project.code} />
        </section>
      )
    }

    <section class="mt-10 border-t border-border pt-8">
      <h2 class="md-h2">Case study</h2>
      <dl class="mt-5 space-y-6">
        {
          caseStudy.problem && (
            <div>
              <dt class="meta text-subtle">Problem</dt>
              <dd class="mt-1.5 text-[0.9375rem] leading-relaxed text-muted">{caseStudy.problem}</dd>
            </div>
          )
        }
        {
          caseStudy.constraints && (
            <div>
              <dt class="meta text-subtle">Constraints</dt>
              <dd class="mt-1.5">
                <ul class="space-y-1 text-[0.9375rem] leading-relaxed text-muted">
                  {caseStudy.constraints.map((c) => <li>{c}</li>)}
                </ul>
              </dd>
            </div>
          )
        }
        <div>
          <dt class="meta text-subtle">Decisions</dt>
          <dd class="mt-1.5">
            <ol class="space-y-4">
              {
                caseStudy.decisions.map((d) => (
                  <li>
                    <p class="text-[0.9375rem] font-medium leading-relaxed">{d.title}</p>
                    <p class="mt-1 text-[0.9375rem] leading-relaxed text-muted">{d.reasoning}</p>
                    {d.tradeoff && <p class="meta mt-1 leading-relaxed text-subtle">Tradeoff: {d.tradeoff}</p>}
                  </li>
                ))
              }
            </ol>
          </dd>
        </div>
        {
          caseStudy.outcome && (
            <div>
              <dt class="meta text-subtle">Outcome</dt>
              <dd class="mt-1.5 text-[0.9375rem] leading-relaxed text-muted">{caseStudy.outcome}</dd>
            </div>
          )
        }
      </dl>
    </section>

    <p class="shell-hint mt-10">
      Also in the shell: <button type="button" class="hint-open" data-open-console data-cmd={`cat ${project.id}`}>cat {project.id}</button>
    </p>

    <nav aria-label="More projects" class="meta mt-12 flex justify-between gap-4 border-t border-border pt-6">
      <a href={`/work/${prev.id}`} class="link text-muted"><span aria-hidden="true">← </span>cd ../{prev.id}<span class="sr-only"> (previous project)</span></a>
      <a href={`/work/${next.id}`} class="link text-muted">cd ../{next.id}<span class="sr-only"> (next project)</span><span aria-hidden="true"> →</span></a>
    </nav>
  </article>
</Base>

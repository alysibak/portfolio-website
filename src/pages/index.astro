---
import Base from "../layouts/Base.astro";
import HomeTerminal from "../components/HomeTerminal.astro";
import Stats from "../components/Stats.astro";
import Principles from "../components/Principles.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import { highlights, navLinks, site } from "../lib/data";

const [first, ...rest] = site.name.split(" ");
---

<Base title={`${site.name} · Software developer co-op, ${site.seeking.label}`} center>
  <div class="dot-grid relative isolate flex min-h-[calc(100vh-5rem)] flex-col justify-center px-6 py-16 md:px-8">
    <div class="mx-auto w-full max-w-xl">
      {/* Filled in by the script below for /for/<company> links. */}
      <p class="meta mb-4 hidden text-accent" data-for-greeting></p>
      <h1 class="text-[2.25rem] font-medium leading-tight tracking-tight md:text-[2.5rem]">
        <span class="inline-block" transition:name="site-name">{first}</span>
        {rest.join(" ")}
      </h1>

      <p class="meta mt-3 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-accent" data-expires={site.seeking.start}>
        <span class="pulse-dot" aria-hidden="true"></span>
        {site.availability}
        <span class="text-muted">({site.termLength})</span>
      </p>

      {/* The things a visitor came for, before anything else. */}
      <div class="mt-6 flex flex-wrap items-center gap-2" data-cta>
        <span class="inline-flex items-center gap-1.5">
          <a href={`mailto:${site.email}`} class="btn btn-primary" data-email>
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="m3 7 9 6 9-6"></path>
            </svg>
            {site.email}
          </a>
          <button type="button" class="btn px-2.5 text-[0.75rem] text-subtle" data-copy={site.email}>copy</button>
        </span>
        <a href={site.resume} class="btn">Resume</a>
        <a href={site.github} target="_blank" rel="noopener noreferrer" class="btn">
          GitHub<span class="sr-only"> (opens in a new tab)</span><span aria-hidden="true">↗</span>
        </a>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="btn">
          LinkedIn<span class="sr-only"> (opens in a new tab)</span><span aria-hidden="true">↗</span>
        </a>
      </div>

      <HomeTerminal />

      <section class="wide mt-12" aria-labelledby="projects-h">
        <div class="mb-3 flex items-baseline justify-between gap-4">
          <h2 id="projects-h" class="md-h2">Projects</h2>
          <a href="/work" class="meta link text-subtle">ls work/ <span aria-hidden="true">→</span></a>
        </div>
        <ProjectGrid />
      </section>

      <div class="mt-10">
        <Stats stats={highlights} />
      </div>

      <div class="mt-10">
        <Principles />
      </div>

      <nav aria-label="Site" class="meta mt-10 flex flex-wrap gap-x-6 gap-y-2.5 text-muted">
        {navLinks.map((link) => (
          <a href={link.href} class="link w-fit">{link.label} <span aria-hidden="true">→</span></a>
        ))}
      </nav>
    </div>
  </div>

</Base>

<script>
  // Personal links for applications: /for/shopify (a Vercel rewrite serves this
  // page) or /?for=shopify. The name is shown as text only, never as HTML.
  function greet() {
    const el = document.querySelector<HTMLElement>("[data-for-greeting]");
    if (!el) return;
    const fromPath = window.location.pathname.match(/^\/for\/([^/]+)/)?.[1];
    let raw = fromPath ?? new URLSearchParams(window.location.search).get("for") ?? "";
    try {
      raw = decodeURIComponent(raw);
    } catch {
      // A malformed link: use it as typed.
    }
    let name = raw.replace(/[-_+]+/g, " ").replace(/[^\p{L}\p{N} &.']/gu, "").trim().slice(0, 40);
    try {
      if (name) sessionStorage.setItem("for", name);
      else name = sessionStorage.getItem("for") ?? "";
    } catch {
      // Storage can be blocked; the greeting just won't carry over.
    }
    if (!name) return;
    // "shopify" -> "Shopify"; anything with capitals is kept as typed ("RBC").
    if (name === name.toLowerCase()) name = name.replace(/\b\p{L}/gu, (c) => c.toUpperCase());
    el.textContent = `Hi, ${name} team. Thanks for taking a look.`;
    el.classList.remove("hidden");
  }
  document.addEventListener("astro:page-load", greet);
</script>

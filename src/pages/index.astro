---
import Base from "../layouts/Base.astro";
import ShellHint from "../components/ShellHint.astro";
import { projects, site, timeline } from "../lib/data";

const [first, ...rest] = site.name.split(" ");
const coops = timeline.filter((t) => t.lane === "co-op").map((t) => t.org);
const award = projects.find((p) => p.award);
---

<Base title={`${site.name} · Software developer co-op, ${site.seeking.label}`} center>
  <div class="flex min-h-[calc(100vh-5rem)] flex-col justify-center px-6 py-16 md:px-8">
    <div class="mx-auto w-full max-w-xl">
      {/* Like a shell's login banner: when this browser was last here. */}
      <p class="meta mb-8 text-[0.75rem] text-subtle" data-last-login aria-hidden="true">&nbsp;</p>
      {/* Filled in by the script below for /for/<company> links. */}
      <p class="meta mb-4 hidden text-accent" data-for-greeting></p>

      <h1 class="text-[2.25rem] font-medium leading-tight tracking-tight md:text-[2.5rem]">
        <span class="inline-block" transition:name="site-name">{first}</span>
        {rest.join(" ")}<span class="name-cursor" aria-hidden="true"></span>
      </h1>

      <p class="mt-5 text-[0.9375rem] text-muted">{site.roleLine}</p>
      <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">
        Co-op terms at {coops.join(" and ")}.
        {award && <> {award.title} won {award.award}.</>}
      </p>
      <p class="meta mt-2 text-subtle">{site.school} · {site.location}</p>
      <p class="meta mt-1 text-accent" data-expires={site.seeking.start}>
        {site.availability} ({site.termLength})
      </p>

      <ShellHint variant="home" />

      <nav aria-label="Site" class="entry-menu meta mt-10 flex flex-col gap-2.5 text-muted">
        <a href="/work" class="link w-fit">Work</a>
        <a href="/experience" class="link w-fit">Experience</a>
        <a href={site.resume} class="link-accent w-fit">Resume</a>
        <a href={`mailto:${site.email}`} class="link w-fit">{site.email}</a>
      </nav>
    </div>
  </div>
</Base>

<script>
  // Personal links for applications: /for/shopify (a Vercel rewrite serves this
  // page) or /?for=shopify. The name is shown as text only, never as HTML.
  function greet() {
    const el = document.querySelector<HTMLElement>("[data-for-greeting]");
    if (!el) return;
    const fromPath = window.location.pathname.match(/^\/for\/([^/]+)/)?.[1];
    let raw = fromPath ?? new URLSearchParams(window.location.search).get("for") ?? "";
    try {
      raw = decodeURIComponent(raw);
    } catch {
      // A malformed link: use it as typed.
    }
    let name = raw.replace(/[-_+]+/g, " ").replace(/[^\p{L}\p{N} &.']/gu, "").trim().slice(0, 40);
    try {
      if (name) sessionStorage.setItem("for", name);
      else name = sessionStorage.getItem("for") ?? "";
    } catch {
      // Storage can be blocked; the greeting just won't carry over.
    }
    if (!name) return;
    // "shopify" -> "Shopify"; anything with capitals is kept as typed ("RBC").
    if (name === name.toLowerCase()) name = name.replace(/\b\p{L}/gu, (c) => c.toUpperCase());
    el.textContent = `Hi, ${name} team. Thanks for taking a look.`;
    el.classList.remove("hidden");
  }
  document.addEventListener("astro:page-load", greet);

  // "Last login: Tue Sep 23 10:12 from your browser", from this browser's
  // previous visit, the way a terminal greets you. First visits get a welcome.
  function lastLogin() {
    const el = document.querySelector<HTMLElement>("[data-last-login]");
    if (!el) return;
    let previous: string | null = null;
    try {
      previous = localStorage.getItem("last-visit");
      localStorage.setItem("last-visit", new Date().toISOString());
    } catch {
      // No storage: say nothing rather than something wrong.
    }
    const then = previous ? new Date(previous) : null;
    if (then && !Number.isNaN(then.getTime())) {
      const day = then.toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric" }).replace(",", "");
      const time = then.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" });
      el.textContent = `Last login: ${day} ${time} from your browser`;
    } else {
      el.textContent = "Welcome. This is your first login.";
    }
  }
  document.addEventListener("astro:page-load", lastLogin);
</script>

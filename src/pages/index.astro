---
import Base from "../layouts/Base.astro";
import HomeTerminal from "../components/HomeTerminal.astro";
import Stats from "../components/Stats.astro";
import { highlights, navLinks, site } from "../lib/data";

const [first, ...rest] = site.name.split(" ");
---

<Base title="Aly Sibak" center>
  <div class="dot-grid relative isolate flex min-h-[calc(100vh-5rem)] flex-col justify-center px-6 py-16 md:px-8">
    <div class="mx-auto w-full max-w-xl">
      <h1 class="text-[2.25rem] font-medium leading-tight tracking-tight md:text-[2.5rem]">
        <span class="inline-block" transition:name="site-name">{first}</span>
        {rest.join(" ")}
      </h1>

      <HomeTerminal />

      <p class="meta mt-5 flex items-center gap-2.5 text-accent">
        <span class="pulse-dot" aria-hidden="true"></span>
        {site.availability}
      </p>

      <div class="mt-8">
        <Stats stats={highlights} />
      </div>

      <nav aria-label="Site" class="meta mt-10 flex flex-wrap gap-x-6 gap-y-2.5 text-muted">
        {navLinks.map((link) => (
          <a href={link.href} class="link w-fit">{link.label} <span aria-hidden="true">→</span></a>
        ))}
        <a href={site.resume} target="_blank" rel="noopener noreferrer" class="link-accent w-fit">
          Resume (PDF)<span class="sr-only"> (opens in a new tab)</span><span aria-hidden="true"> ↗</span>
        </a>
      </nav>
    </div>
  </div>
</Base>

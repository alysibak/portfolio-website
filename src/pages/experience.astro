---
import Base from "../layouts/Base.astro";
import ShellHint from "../components/ShellHint.astro";
import GitGraph from "../components/GitGraph.astro";
import DegreeBar from "../components/DegreeBar.astro";
import Prompt from "../components/Prompt.astro";
import { leadership, teachingNote, teachingStats } from "../lib/data";
---

<Base
  title="Experience, Aly Sibak"
  description="Two co-op terms, three paid TA appointments at the University of Guelph, and student leadership."
>
  <div class="mx-auto max-w-xl">
    <Prompt cmd="git log --graph --all" />
    <h1 class="md-h1 mt-3">Experience</h1>
    <ShellHint variant="page" />

    <section class="mt-12">
      <h2 class="md-h2">Timeline</h2>
      <div class="mt-4">
        <GitGraph />
      </div>
    </section>

    <section class="mt-12 border-t border-border pt-8">
      <h2 class="md-h2">Teaching at Guelph</h2>
      <p class="meta mt-4 leading-relaxed text-muted">
        {
          teachingStats.map((stat, i) => (
            <>
              {i > 0 && <span class="text-subtle"> · </span>}
              <span class="text-ink">{stat.value.toLocaleString("en-US")}{stat.suffix}</span> {stat.label}
            </>
          ))
        }
      </p>
      <p class="meta mt-1 leading-relaxed text-subtle">{teachingNote}</p>
    </section>

    <section class="mt-12 border-t border-border pt-8">
      <h2 class="md-h2">Leadership and activities</h2>
      <ul class="mt-4 space-y-4">
        {
          leadership.map((item) => (
            <li>
              <p class="text-[0.9375rem] leading-snug">
                <span class="font-medium">{item.role}</span> <span class="text-subtle">@</span> {item.org}
              </p>
              <p class="meta text-subtle">{item.period}</p>
              <p class="meta mt-1 leading-relaxed text-muted">{item.context}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12 border-t border-border pt-8">
      <h2 class="md-h2">Education</h2>
      <div class="mt-4">
        <DegreeBar />
      </div>
    </section>

    <a href="/" class="meta link mt-16 inline-block text-subtle">cd ~<span class="sr-only"> (home)</span></a>
  </div>
</Base>

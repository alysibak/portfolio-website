---
import Base from "../layouts/Base.astro";
import ShellHint from "../components/ShellHint.astro";
import GitGraph from "../components/GitGraph.astro";
import Stats from "../components/Stats.astro";
import DegreeBar from "../components/DegreeBar.astro";
import Prompt from "../components/Prompt.astro";
import { leadership, teachingNote, teachingStats } from "../lib/data";

/** Badge colours, one per leadership role in order. Full class names so Tailwind keeps them. */
const markColors = ["bg-plum", "bg-accent", "bg-teal", "bg-amber"];
---

<Base
  title="Experience, Aly Sibak"
  description="Two co-op terms, three paid TA appointments at the University of Guelph, and student leadership."
>
  <div class="mx-auto max-w-xl">
    <Prompt cmd="git log --graph --all" />
    <h1 class="md-h1 mt-3">Experience</h1>
    <ShellHint variant="page" />

    <section class="mt-12">
      <h2 class="md-h2">Timeline</h2>
      <div class="mt-4">
        <GitGraph />
      </div>
    </section>

    <section class="mt-12 border-t border-border pt-8">
      <h2 class="md-h2">Teaching at Guelph</h2>
      <div class="mt-4">
        <Stats stats={teachingStats} columns={3} />
      </div>
      <p class="meta mt-3 leading-relaxed text-muted">{teachingNote}</p>
    </section>

    <section class="mt-12 border-t border-border pt-8">
      <h2 class="md-h2">Leadership and activities</h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {
          leadership.map((item, i) => (
            <li class="flex gap-3 rounded-md border border-border bg-paper p-3">
              <span
                class:list={[
                  "grid h-9 w-9 shrink-0 place-items-center rounded-md font-mono text-[0.6875rem] font-bold text-paper",
                  markColors[i % markColors.length],
                ]}
                aria-hidden="true"
              >
                {item.mark}
              </span>
              <div class="min-w-0">
                <p class="text-[0.9375rem] font-medium leading-snug">{item.role}</p>
                <p class="text-[0.8125rem] leading-snug text-muted">
                  {item.org} · {item.period}
                </p>
                <p class="meta mt-1.5 leading-relaxed text-muted">{item.context}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12 border-t border-border pt-8">
      <h2 class="md-h2">Education</h2>
      <div class="mt-4">
        <DegreeBar />
      </div>
    </section>

    <a href="/" class="meta link mt-16 inline-block text-subtle">cd ~<span class="sr-only"> (home)</span></a>
  </div>
</Base>

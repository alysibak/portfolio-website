---
import Base from "../layouts/Base.astro";
import ShellHint from "../components/ShellHint.astro";
import Flow from "../components/Flow.astro";
import AwardBadge from "../components/AwardBadge.astro";
import StackChips from "../components/StackChips.astro";
import LiveStatus from "../components/LiveStatus.astro";
import Prompt from "../components/Prompt.astro";
import Screenshot from "../components/Screenshot.astro";
import RepoStats from "../components/RepoStats.astro";
import { coursework, projects } from "../lib/data";
import { projectShots } from "../lib/shots";
---

<Base
  title="Selected work, Aly Sibak"
  description="Four projects, each with the problem, the constraints, the decisions and what they cost, and the outcome."
>
  <div class="mx-auto max-w-xl">
    <Prompt cmd="ls work/" />
    <h1 class="md-h1 mt-3">Selected work</h1>
    <ul class="meta mt-3 flex flex-wrap gap-x-5 gap-y-1" aria-label="Projects">
      {
        projects.map((project) => (
          <li>
            <a href={`#${project.id}`} class="link-accent">{project.id}/</a>
          </li>
        ))
      }
    </ul>
    <ShellHint variant="work" />

    <div class="mt-14 space-y-16">
      {
        projects.map((project, i) => (
          <section id={project.id} class="scroll-mt-8" aria-labelledby={`${project.id}-title`}>
            <Prompt path="~/work" cmd={`open ${project.id}`} />
            <div class="mt-3">
              {projectShots[project.id] ? (
                <Screenshot project={project} href={`/work/${project.id}`} eager={i === 0} />
              ) : (
                <div class="shot-window overflow-hidden rounded-md border border-border bg-paper">
                  <div class="shot-bar meta flex items-center gap-3 border-b border-border px-3 py-2 text-[0.6875rem] text-subtle">
                    <span class="shot-dots flex gap-1.5" aria-hidden="true">
                      <i />
                      <i />
                      <i />
                    </span>
                    how it fits together
                  </div>
                  <div class="px-4 pb-4 pt-0.5">
                    <Flow project={project} />
                  </div>
                </div>
              )}
            </div>

            <div class="mt-5 flex items-baseline justify-between gap-4">
              <h2 id={`${project.id}-title`} class="text-lg font-medium">
                <a href={`/work/${project.id}`} class="link inline-block" transition:name={`project-${project.id}`}>
                  {project.title}
                </a>
              </h2>
              {project.year && <span class="meta shrink-0 tabular-nums text-subtle">{project.year}</span>}
            </div>
            <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-muted">{project.tagline}</p>
            <p class="meta mt-1 text-subtle">{project.context}</p>
            <div class="mt-4">
              <StackChips stack={project.stack} />
            </div>

            {project.ownership && (
              <p class="ownership meta mt-4 leading-relaxed text-muted">
                <span class="text-subtle">What I owned </span>
                {project.ownership}
              </p>
            )}

            {project.award && <AwardBadge award={project.award} />}

            <div class="meta mt-5 flex flex-wrap items-center gap-x-4 gap-y-1">
              <a href={`/work/${project.id}`} class="link-accent">
                cat {project.id}.md <span aria-hidden="true">→</span>
              </a>
              {project.links.map((link) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer" class="link">
                  {link.label.toLowerCase()}
                  <span class="sr-only"> (opens in a new tab)</span>
                  <span aria-hidden="true"> ↗</span>
                </a>
              ))}
              <RepoStats id={project.id} compact />
              <LiveStatus project={project} />
            </div>
          </section>
        ))
      }
    </div>

    <section class="mt-20" aria-labelledby="coursework-title">
      <Prompt path="~/work" cmd="ls coursework/" />
      <h2 id="coursework-title" class="md-h2 mt-3">{coursework.title}</h2>
      <ul class="mt-3 space-y-1 text-[0.9375rem] leading-relaxed text-muted">
        {coursework.items.map((item) => <li>{item}</li>)}
      </ul>
      <div class="meta mt-4 flex flex-wrap gap-x-4 gap-y-1">
        {
          coursework.links.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="link">
              {link.label}
              <span class="sr-only"> (opens in a new tab)</span>
              <span aria-hidden="true"> ↗</span>
            </a>
          ))
        }
      </div>
    </section>

    <a href="/" class="meta link mt-16 inline-block text-subtle">cd ~<span class="sr-only"> (home)</span></a>
  </div>
</Base>

---
import Base from "../layouts/Base.astro";
import ShellHint from "../components/ShellHint.astro";
import Flow from "../components/Flow.astro";
import AwardBadge from "../components/AwardBadge.astro";
import StackChips from "../components/StackChips.astro";
import LiveStatus from "../components/LiveStatus.astro";
import { coursework, projects } from "../lib/data";
---

<Base
  title="Selected work, Aly Sibak"
  description="Four projects, each with the problem, the constraints, the decisions and what they cost, and the outcome."
>
  <div class="mx-auto max-w-xl">
    <h1 class="text-2xl font-medium">Selected work</h1>
    <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">
      Each project states the problem, the constraints, the decisions and what
      each one cost, and where it ended up.
    </p>
    <ShellHint variant="work" />

    <ul class="mt-12 divide-y divide-border">
      {
        projects.map((project) => (
          <li class="py-10 first:pt-0 last:pb-0">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="text-lg font-medium">
                <a href={`/work/${project.id}`} class="link inline-block" transition:name={`project-${project.id}`}>
                  {project.title}
                </a>
              </h2>
              {project.year && (
                <span class="meta shrink-0 tabular-nums text-subtle">
                  {project.year}
                </span>
              )}
            </div>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">
              {project.tagline}
            </p>
            <p class="meta mt-1 text-subtle">{project.context}</p>
            <div class="mt-4">
              <StackChips stack={project.stack} />
            </div>

            <Flow project={project} />

            {project.ownership && (
              <p class="ownership meta mt-4 leading-relaxed text-muted">
                <span class="text-subtle">What I owned </span>
                {project.ownership}
              </p>
            )}

            {project.award && <AwardBadge award={project.award} />}

            {project.finding && (
              <p class="mt-4 text-[0.9375rem] leading-relaxed text-muted">
                {project.finding}
              </p>
            )}

            {project.links.length > 0 && (
              <div class="meta mt-4 flex flex-wrap gap-x-4 gap-y-1">
                {project.links.map((link) => (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class:list={[
                      link.label === "Live" || link.label === "Devpost"
                        ? "link-accent"
                        : "link",
                    ]}
                  >
                    {link.label}
                    <span class="sr-only"> (opens in a new tab)</span>
                    <span aria-hidden="true"> ↗</span>
                  </a>
                ))}
                <LiveStatus project={project} />
              </div>
            )}

            <a href={`/work/${project.id}`} class="meta link mt-6 inline-block">
              Read the case study <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>

    <section class="mt-14 border-t border-border pt-10">
      <h2 class="text-lg font-medium">{coursework.title}</h2>
      <ul class="mt-3 space-y-1 text-[0.9375rem] leading-relaxed text-muted">
        {coursework.items.map((item) => <li>{item}</li>)}
      </ul>
      <div class="meta mt-4 flex flex-wrap gap-x-4 gap-y-1">
        {
          coursework.links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="link"
            >
              {link.label}
              <span class="sr-only"> (opens in a new tab)</span>
              <span aria-hidden="true"> ↗</span>
            </a>
          ))
        }
      </div>
    </section>

    <a href="/" class="meta mt-16 inline-block text-subtle link">← Home</a>
  </div>
</Base>

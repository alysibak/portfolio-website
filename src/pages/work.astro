---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import ShellHint from "../components/ShellHint.astro";
import Flow from "../components/Flow.astro";
import Prompt from "../components/Prompt.astro";
import { coursework, liveUrl, projects } from "../lib/data";
import { projectShots } from "../lib/shots";

// A plain index. On wide screens, the project under the pointer (or keyboard
// focus) shows its screenshot beside the list; on phones, each has its own.
const host = (id: string) => {
  const project = projects.find((p) => p.id === id);
  return project ? (liveUrl(project) ?? "").replace(/^https?:\/\//, "") : "";
};
---

<Base
  title="Selected work, Aly Sibak"
  description="Four projects, each with the problem, the constraints, the decisions and what they cost, and the outcome."
>
  <div class="mx-auto max-w-xl">
    <Prompt cmd="ls work/" />
    <h1 class="md-h1 mt-3">Selected work</h1>
    <ShellHint variant="work" />
  </div>

  <div class="work-index mx-auto mt-14" data-work-index>
    <ol class="work-list" aria-label="Projects">
      {
        projects.map((project) => {
          const shot = projectShots[project.id]?.shots[0];
          return (
            <li>
              <a href={`/work/${project.id}`} class="work-row group block" data-preview={project.id}>
                <span class="flex items-baseline justify-between gap-4">
                  <span class="text-lg font-medium text-ink transition-colors group-hover:text-accent">
                    <span class="inline-block" transition:name={`project-${project.id}`}>{project.title}</span>
                  </span>
                  {project.year && <span class="meta shrink-0 tabular-nums text-subtle">{project.year}</span>}
                </span>
                <span class="mt-1 block leading-relaxed text-muted">{project.tagline}</span>
                <span class="meta mt-1 block text-subtle">
                  {project.context}
                  {project.award && <> · {project.award.split(", ")[0]}</>}
                </span>
              </a>
              {shot && (
                <Picture
                  src={shot.src}
                  alt={shot.alt}
                  widths={[480, 768]}
                  sizes="calc(100vw - 3rem)"
                  formats={["avif", "webp"]}
                  loading="lazy"
                  class="work-thumb mt-4 block h-auto w-full rounded-sm border border-border"
                />
              )}
            </li>
          );
        })
      }
    </ol>

    <div class="work-preview" aria-hidden="true">
      {
        projects.map((project, i) => {
          const shot = projectShots[project.id]?.shots[0];
          return (
            <figure class="preview" data-preview-for={project.id} hidden={i > 0}>
              {shot ? (
                <Picture
                  src={shot.src}
                  alt=""
                  widths={[480, 768, 1152]}
                  sizes="26rem"
                  formats={["avif", "webp"]}
                  loading={i === 0 ? "eager" : "lazy"}
                  class="preview-img block h-auto w-full rounded-sm border border-border"
                />
              ) : (
                <div class="rounded-sm border border-border px-4 pb-4 pt-0.5">
                  <Flow project={project} />
                </div>
              )}
              <figcaption class="meta mt-2 text-[0.75rem] text-subtle">
                {shot ? `${host(project.id)}${shot.path}` : "how it fits together"}
              </figcaption>
            </figure>
          );
        })
      }
    </div>
  </div>

  <div class="mx-auto max-w-xl">
    <section class="mt-20" aria-labelledby="coursework-title">
      <Prompt path="~/work" cmd="ls coursework/" />
      <h2 id="coursework-title" class="md-h2 mt-3">{coursework.title}</h2>
      <ul class="mt-3 space-y-1 leading-relaxed text-muted">
        {coursework.items.map((item) => <li>{item}</li>)}
      </ul>
      <div class="meta mt-4 flex flex-wrap gap-x-4 gap-y-1">
        {
          coursework.links.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="link">
              {link.label}
              <span class="sr-only"> (opens in a new tab)</span>
              <span aria-hidden="true"> ↗</span>
            </a>
          ))
        }
      </div>
    </section>

    <a href="/" class="meta link mt-16 inline-block text-subtle">cd ~<span class="sr-only"> (home)</span></a>
  </div>
</Base>

<script>
  // Pointer or focus on a project shows its preview, in colour. Leaving the
  // list keeps the last preview but fades it back to grey.
  document.addEventListener("astro:page-load", () => {
    const index = document.querySelector<HTMLElement>("[data-work-index]");
    if (!index) return;
    const show = (id: string) => {
      index.querySelectorAll<HTMLElement>("[data-preview-for]").forEach((f) => (f.hidden = f.dataset.previewFor !== id));
      index.dataset.hot = "";
    };
    index.querySelectorAll<HTMLElement>("[data-preview]").forEach((row) => {
      const id = row.dataset.preview!;
      row.addEventListener("pointerenter", () => show(id));
      row.addEventListener("focus", () => show(id));
      row.addEventListener("pointerleave", () => delete index.dataset.hot);
      row.addEventListener("blur", () => delete index.dataset.hot);
    });
  });
</script>

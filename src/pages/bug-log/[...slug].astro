---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { publishedPosts } from "../../lib/bug-log";
import { projects } from "../../lib/data";

// One file builds the index (/bug-log) and each post. With nothing published,
// it builds nothing at all, so there's never an empty section on the site.
export async function getStaticPaths() {
  const posts = await publishedPosts();
  if (posts.length === 0) return [];
  return [
    { params: { slug: undefined }, props: { posts, post: undefined } },
    ...posts.map((post) => ({ params: { slug: post.id }, props: { posts, post } })),
  ];
}

const { posts, post } = Astro.props;
const date = (d: Date) => d.toLocaleDateString("en-CA", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
const rendered = post ? await render(post) : undefined;
const project = post ? projects.find((p) => p.id === post.data.project) : undefined;
---

{
  post && rendered ? (
    <Base title={`${post.data.title}, Aly Sibak`} description={post.data.summary}>
      <article class="mx-auto max-w-xl">
        <a href="/bug-log" class="meta link text-subtle">← bug.log</a>
        <p class="meta mt-8 text-subtle">
          {date(post.data.date)} · <a href={`/work/${post.data.project}`} class="link">{project?.title}</a>
        </p>
        <h1 class="mt-2 text-2xl font-medium leading-snug">{post.data.title}</h1>
        <p class="mt-3 text-[1.0625rem] leading-relaxed text-muted">{post.data.summary}</p>
        <div class="prose-log mt-8">
          <rendered.Content />
        </div>
      </article>
    </Base>
  ) : (
    <Base title="bug.log, Aly Sibak" description="Write-ups of bugs I found in my own projects, and how.">
      <div class="mx-auto max-w-xl">
        <h1 class="text-2xl font-medium">bug.log</h1>
        <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">
          Bugs I found in my own projects, and how I found them.
        </p>
        <ul class="mt-10 divide-y divide-border">
          {posts.map((p) => (
            <li class="py-6 first:pt-0">
              <p class="meta text-subtle">{date(p.data.date)}</p>
              <h2 class="mt-1 text-lg font-medium">
                <a href={`/bug-log/${p.id}`} class="link">{p.data.title}</a>
              </h2>
              <p class="mt-1 text-[0.9375rem] leading-relaxed text-muted">{p.data.summary}</p>
            </li>
          ))}
        </ul>
      </div>
    </Base>
  )
}

---
import Base from "../layouts/Base.astro";
import { projects, resumeCommunity, resumeWork, site, skills } from "../lib/data";

// Rendered as a terminal printing `cat resume.md`. Everything comes from
// src/lib/data.ts, the same records the rest of the site uses; edit it there.
const { education } = site;
const bare = (url: string) => url.replace(/^https?:\/\/(www\.)?/, "");
const linkLabel = (label: string) => (label === "Source" ? "code" : label.toLowerCase());
let line = 0; // Order in which sections print in.
---

<Base
  title="Resume, Aly Sibak"
  description="Computer Science co-op at the University of Guelph. Two co-op terms of full-stack development, three TA appointments, and four projects."
>
  <article class="term-resume mx-auto max-w-2xl">
    <div class="term-window overflow-hidden rounded-md border border-border bg-paper">
      <div class="term-bar meta flex items-center justify-between gap-4 border-b border-border px-4 py-2.5">
        <span class="text-accent">aly@portfolio: ~/resume</span>
        <button type="button" class="text-subtle transition-colors hover:text-accent" data-print>save as pdf</button>
      </div>

      <div class="term-body">
        <p class="t-prompt"><span class="text-accent">aly@portfolio:~$</span> cat resume.md</p>

        <header class="t-block" style={`--i:${line++}`}>
          <h1 class="t-h1"><span class="t-mark">#</span> {site.name}</h1>
          <p class="t-contact">
            <a href={`mailto:${site.email}`} class="link-accent">{site.email}</a>
            <span>{site.location}</span>
            <a href="/" class="link">{bare(site.url)}</a>
            <a href={site.github} target="_blank" rel="noopener noreferrer" class="link no-print-url">
              {bare(site.github)}<span class="sr-only"> (opens in a new tab)</span>
            </a>
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="link no-print-url">
              linkedin<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </p>
        </header>

        <section class="t-block" style={`--i:${line++}`}>
          <h2 class="t-h2"><span class="t-mark">##</span> Education</h2>
          <div class="t-row">
            <p><span class="t-strong">{education.degree}</span>, {education.school}</p>
            <span class="t-date">{education.period}</span>
          </div>
          <p class="t-dim">{[...education.highlights, education.detail].join(" · ")}</p>
        </section>

        <section class="t-block" style={`--i:${line++}`}>
          <h2 class="t-h2"><span class="t-mark">##</span> Skills</h2>
          <dl class="t-kv">
            {
              skills.map((group) => (
                <div>
                  <dt>{group.label.toLowerCase()}</dt>
                  <dd>{group.items.join(", ")}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section class="t-block" style={`--i:${line++}`}>
          <h2 class="t-h2"><span class="t-mark">##</span> Work experience</h2>
          {
            resumeWork.map((job) => (
              <div class="t-entry">
                <div class="t-row">
                  <p>
                    <span class="t-strong">{job.role}</span> <span class="t-dim">@</span> {job.org}
                  </p>
                  <span class="t-date">{job.period}</span>
                </div>
                <p class="t-dim">
                  {job.summary}
                  {job.stack.length > 0 && (
                    <>
                      {" "}
                      <span class="t-key">stack:</span> {job.stack.join(", ")}
                    </>
                  )}
                </p>
                <ul class="t-list">
                  {job.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </section>

        <section class="t-block" style={`--i:${line++}`}>
          <h2 class="t-h2"><span class="t-mark">##</span> Projects</h2>
          {
            projects.map((project) => (
              <div class="t-entry">
                <div class="t-row">
                  <p>
                    <a href={`/work/${project.id}`} class="link t-strong">{project.title}</a>
                    <span class="t-dim"> · {project.resume.label}</span>
                  </p>
                  {project.year && <span class="t-date">{project.year.replace(/–$/, "–present")}</span>}
                </div>
                <p class="t-dim">
                  <span class="t-key">stack:</span> {project.resume.stack.join(", ")}
                  {project.links.map((link) => (
                    <>
                      {" "}
                      <a href={link.href} target="_blank" rel="noopener noreferrer" class="link-accent whitespace-nowrap">
                        [{linkLabel(link.label)} ↗]<span class="sr-only"> (opens in a new tab)</span>
                      </a>
                    </>
                  ))}
                </p>
                <ul class="t-list">
                  {project.resume.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </section>

        <section class="t-block" style={`--i:${line++}`}>
          <h2 class="t-h2"><span class="t-mark">##</span> Leadership and community</h2>
          <ul class="t-list">
            {resumeCommunity.map((l) => <li>{l}</li>)}
          </ul>
        </section>

        <p class="t-prompt t-block mt-6" style={`--i:${line++}`}>
          <span class="text-accent">aly@portfolio:~$</span>
          <span class="console-cursor ml-1 align-middle" aria-hidden="true"></span>
        </p>
      </div>
    </div>

    <p class="shell-hint mt-5">
      Also in the shell: <button type="button" class="hint-open" data-open-console data-cmd="cat resume">cat resume</button>,
      or from yours: <a href="/resume.txt" class="link-accent" data-astro-reload>curl {bare(site.url)}/resume.txt</a>
    </p>
  </article>
</Base>

<script>
  // "save as pdf" opens the print dialog; print styles make it a one-pager.
  document.addEventListener("click", (e) => {
    if (e.target instanceof Element && e.target.closest("[data-print]")) window.print();
  });
</script>

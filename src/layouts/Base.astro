---
import "@fontsource/source-sans-3/latin-400.css";
import "@fontsource/source-sans-3/latin-500.css";
import "@fontsource/source-sans-3/latin-600.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import "@fontsource/jetbrains-mono/latin-700.css";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Console from "../components/Console";
import Palette from "../components/Palette";
import DevToolsEgg from "../components/DevToolsEgg.astro";
import { projects, site } from "../lib/data";
import { ogCardFor } from "../lib/og";

interface Props {
  title?: string;
  /** One sentence for search results and link previews. */
  description?: string;
  center?: boolean;
}

const { title = "Aly Sibak", description = site.description, center = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const ogCard = ogCardFor(Astro.url.pathname);
const ogImage = new URL(`/og/${ogCard.slug}.png`, Astro.site ?? Astro.url).href;

// Tells search engines who this site is about. Home page only.
const person =
  Astro.url.pathname === "/"
    ? JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: site.name,
        url: site.url,
        email: `mailto:${site.email}`,
        description: site.description,
        affiliation: { "@type": "CollegeOrUniversity", name: site.education.school },
        address: {
          "@type": "PostalAddress",
          addressLocality: "Mississauga",
          addressRegion: "ON",
          addressCountry: "CA",
        },
        sameAs: [site.github, site.linkedin],
        knowsAbout: [...new Set(projects.flatMap((p) => p.stack))],
      })
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${ogCard.title}: ${ogCard.subtitle}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {person && <script type="application/ld+json" set:html={person} />}
    <!-- Vercel Web Analytics. Cookieless, so no consent banner is needed.
         Inert until Web Analytics is enabled for the project in the Vercel
         dashboard; 404s harmlessly on localhost and any non-Vercel host. -->
    <script defer src="/_vercel/insights/script.js"></script>
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Apply a saved theme before first paint, and again after each client-side
      // navigation (which replaces <html>'s attributes). Key matches src/lib/theme.ts.
      (function () {
        function apply() {
          try {
            var t = localStorage.getItem("theme");
            var root = document.documentElement;
            var crt = t === "green" || t === "amber";
            if (t === "dark" || t === "light" || crt) root.setAttribute("data-theme", crt ? "dark" : t);
            else root.removeAttribute("data-theme");
            if (crt) root.setAttribute("data-crt", t);
            else root.removeAttribute("data-crt");
          } catch (e) {}
        }
        apply();
        if (!window.__themeSwap) {
          window.__themeSwap = true;
          document.addEventListener("astro:after-swap", apply);
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-3 focus:py-2 focus:text-paper focus:text-sm">
      Skip to content
    </a>

    {center ? (
      <main id="main">
        <slot />
        <Footer showAvailability={false} />
      </main>
    ) : (
      <>
        <Nav />
        <main id="main" class="px-6 py-16 md:px-8 md:py-20">
          <slot />
        </main>
        <Footer />
      </>
    )}

    {/* Phones: email and resume stay in reach once the page scrolls. */}
    <nav class="contact-dock" aria-label="Contact" data-dock hidden>
      <a href={`mailto:${site.email}`} class="btn btn-primary shadow-lg">Email me</a>
      {Astro.url.pathname.replace(/\/$/, "") !== site.resume && <a href={site.resume} class="btn bg-paper shadow-lg">Resume</a>}
    </nav>

    <Console client:idle transition:persist />
    <Palette client:idle transition:persist />
    <DevToolsEgg />
    <script>
      import { navigate } from "astro:transitions/client";

      // Keyboard shortcuts: g then w/e/r/h goes to a page, like a mail client.
      // The Konami code turns the site into a green phosphor terminal.
      const GO: Record<string, string> = { h: "/", w: "/work", e: "/experience", r: "/resume" };
      const KONAMI = ["ArrowUp", "ArrowUp", "ArrowDown", "ArrowDown", "ArrowLeft", "ArrowRight", "ArrowLeft", "ArrowRight", "b", "a"];
      let gAt = 0;
      let konami = 0;

      // The phone contact dock: shown once the page's own contact buttons (or,
      // without them, the first screen) have scrolled away, and hidden again
      // at the footer, which has the same links.
      let dockWatch: IntersectionObserver | undefined;
      let dockScroll: (() => void) | undefined;
      function dock() {
        dockWatch?.disconnect();
        if (dockScroll) window.removeEventListener("scroll", dockScroll);
        dockScroll = undefined;
        const bar = document.querySelector<HTMLElement>("[data-dock]");
        const footer = document.querySelector(".site-footer");
        if (!bar || !footer) return;
        const cta = document.querySelector("[data-cta]");
        const seen = new Map<Element, boolean>([[footer, false]]);
        if (cta) seen.set(cta, true);
        const update = () => {
          const top = cta ? seen.get(cta) : window.scrollY < 400;
          bar.hidden = Boolean(top || seen.get(footer));
        };
        dockWatch = new IntersectionObserver((entries) => {
          for (const e of entries) seen.set(e.target, e.isIntersecting);
          update();
        });
        seen.forEach((_, el) => dockWatch!.observe(el));
        if (!cta) {
          dockScroll = update;
          window.addEventListener("scroll", update, { passive: true });
        }
        update();
      }
      document.addEventListener("astro:page-load", dock);

      document.addEventListener("keydown", (e) => {
        const t = e.target;
        if (t instanceof HTMLElement && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;

        konami = key === KONAMI[konami] ? konami + 1 : key === KONAMI[0] ? 1 : 0;
        if (konami === KONAMI.length) {
          konami = 0;
          window.__consoleCmd = "theme green";
          window.__consoleRequested = true;
          window.dispatchEvent(new Event("console:open"));
          return;
        }

        if (document.querySelector('[aria-modal="true"], dialog[open]')) return;
        if (key === "g") {
          gAt = Date.now();
          return;
        }
        const to = GO[key];
        if (to && Date.now() - gAt < 1200) {
          e.preventDefault();
          gAt = 0;
          if (window.location.pathname.replace(/\/$/, "") !== to.replace(/\/$/, "")) navigate(to);
        }
        gAt = 0;
      });
    </script>
    <script is:inline>
      // Buttons that open the console. The console hydrates on idle, so a tap
      // before then is queued on window and picked up when it mounts. Inline
      // scripts rerun on every client-side navigation, hence the guard.
      if (!window.__consoleClicks) {
        window.__consoleClicks = true;
        document.addEventListener("click", function (e) {
          var target = e.target instanceof Element && e.target.closest("[data-open-console]");
          if (!target) return;
          e.preventDefault();
          window.__consoleCmd = target.getAttribute("data-cmd") || undefined;
          window.__consoleRequested = true;
          window.dispatchEvent(new Event("console:open"));
        });

        // Shortcuts pressed before the shell or search has loaded are queued
        // the same way. Once each loads, it handles its own keys.
        document.addEventListener("keydown", function (e) {
          var t = e.target;
          if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
          if (!window.__paletteReady && (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
            e.preventDefault();
            window.__paletteRequested = true;
          } else if (!window.__consoleReady && !e.metaKey && !e.ctrlKey && (e.key === "/" || e.key === "~")) {
            e.preventDefault();
            window.__consoleRequested = true;
          }
        });
      }
    </script>
  </body>
</html>

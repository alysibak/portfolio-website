---
interface Props {
  /** e.g. "Best Use of Presage Technologies, out of 800 participants" */
  award: string;
}

const { award } = Astro.props;
const split = award.indexOf(", ");
const title = split === -1 ? award : award.slice(0, split);
const detail = split === -1 ? "" : award.slice(split + 2);
---

<div class="award mt-4 flex w-fit items-center gap-3 rounded-md border border-border bg-paper py-2.5 pl-3 pr-4">
  <svg class="award-medal h-10 w-9 shrink-0" viewBox="0 0 58 64" aria-hidden="true">
    <path class="fill-teal" d="M16 0h12l-6 26H10z"></path>
    <path class="fill-plum" d="M30 0h12l6 26H36z"></path>
    <circle class="fill-accent" cx="29" cy="40" r="20"></circle>
    <path class="fill-paper" d="M29 29l3.2 6.6 7.2 1-5.2 5 1.3 7.2L29 45.4l-6.5 3.4 1.3-7.2-5.2-5 7.2-1z"></path>
  </svg>
  <p>
    <span class="block text-[0.9375rem] font-medium leading-snug">{title}</span>
    {detail && <span class="meta block text-subtle">{detail}</span>}
  </p>
</div>

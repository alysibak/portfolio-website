---
interface Props {
  /** e.g. "Best Use of Presage Technologies, out of 800 participants" */
  award: string;
}

const { award } = Astro.props;
const split = award.indexOf(", ");
const title = split === -1 ? award : award.slice(0, split);
const detail = split === -1 ? "" : award.slice(split + 2);
---

<p class="meta mt-4 leading-relaxed">
  <span class="text-accent">award</span>
  <span class="text-ink">{title}</span>
  {detail && <span class="text-subtle">· {detail}</span>}
</p>

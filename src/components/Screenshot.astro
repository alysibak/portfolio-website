---
import { Picture, getImage } from "astro:assets";
import { liveUrl, type Project } from "../lib/data";
import { projectShots } from "../lib/shots";

interface Props {
  project: Project;
  /** Wrap the first screenshot in a link here instead of showing tabs. */
  href?: string;
  /** Above the fold: load right away. */
  eager?: boolean;
  /** Rendered width, for picking an image size. */
  sizes?: string;
}

const { project, href, eager = false, sizes = "(min-width: 40rem) 36rem, calc(100vw - 3rem)" } = Astro.props;
const entry = projectShots[project.id];
const shots = entry ? (href ? entry.shots.slice(0, 1) : entry.shots) : [];
const host = (liveUrl(project) ?? "").replace(/^https?:\/\//, "") || `${project.id}.local`;
const widths = [480, 768, 1152, 1536];
// Full size, for the enlarged view on project pages.
const full = href ? [] : await Promise.all(shots.map((shot) => getImage({ src: shot.src, width: 1600, format: "webp" })));
---

{
  shots.length > 0 && (
    <figure class="shot" data-shots>
      <div class="shot-window overflow-hidden rounded-md border border-border bg-paper">
        <div class="shot-bar meta flex items-center gap-3 border-b border-border px-3 py-2 text-[0.6875rem]">
          <span class="shot-dots flex shrink-0 gap-1.5" aria-hidden="true">
            <i />
            <i />
            <i />
          </span>
          <span class="min-w-0 flex-1 truncate text-subtle">
            <span class="text-muted">{host}</span>
            <span data-shot-path>{shots[0].path}</span>
          </span>
          {shots.length > 1 && (
            <span class="flex shrink-0 gap-1" role="group" aria-label={`${project.title} screenshots`}>
              {shots.map((shot, i) => (
                <button
                  type="button"
                  class="shot-tab"
                  aria-pressed={i === 0 ? "true" : "false"}
                  data-shot-tab={i}
                  data-path={shot.path}
                >
                  {shot.label}
                </button>
              ))}
            </span>
          )}
        </div>
        {href ? (
          <a href={href} class="shot-link block" aria-label={`${project.title} case study`}>
            <Picture
              src={shots[0].src}
              alt={shots[0].alt}
              widths={widths}
              sizes={sizes}
              formats={["avif", "webp"]}
              loading={eager ? "eager" : "lazy"}
              class="block h-auto w-full"
            />
          </a>
        ) : (
          shots.map((shot, i) => (
            <div data-shot={i} hidden={i > 0}>
              <button
                type="button"
                class="shot-zoom block w-full"
                data-zoom={full[i].src}
                data-alt={shot.alt}
                aria-label={`Enlarge: ${shot.alt}`}
              >
                <Picture
                  src={shot.src}
                  alt=""
                  widths={widths}
                  sizes={sizes}
                  formats={["avif", "webp"]}
                  loading={eager && i === 0 ? "eager" : "lazy"}
                  class="block h-auto w-full"
                />
              </button>
            </div>
          ))
        )}
      </div>
      {!href && entry?.note && <figcaption class="meta mt-2 leading-relaxed text-subtle">{entry.note}</figcaption>}
      {!href && (
        <dialog class="shot-dialog" aria-label={`${project.title} screenshot`} data-zoom-dialog>
          <form method="dialog" class="flex justify-end">
            <button class="meta px-2 py-1 text-subtle hover:text-ink" data-zoom-close>close ✕</button>
          </form>
          <img src="" alt="" class="mt-1 block h-auto max-h-[80vh] w-auto max-w-full rounded-sm" data-zoom-img />
        </dialog>
      )}
    </figure>
  )
}

<script>
  // Clicking a screenshot opens it full size; a click outside it, Esc, or
  // "close" shuts it.
  document.addEventListener("click", (e) => {
    const target = e.target instanceof Element ? e.target : null;
    const zoom = target?.closest<HTMLButtonElement>("[data-zoom]");
    const dialog = zoom?.closest("[data-shots]")?.querySelector<HTMLDialogElement>("[data-zoom-dialog]");
    if (zoom && dialog) {
      const img = dialog.querySelector<HTMLImageElement>("[data-zoom-img]")!;
      img.src = zoom.dataset.zoom ?? "";
      img.alt = zoom.dataset.alt ?? "";
      dialog.showModal();
      return;
    }
    if (target instanceof HTMLDialogElement && target.matches("[data-zoom-dialog]")) target.close();
  });

  // Tabs in the window's title bar switch between a project's screenshots.
  document.addEventListener("click", (e) => {
    const tab = e.target instanceof Element ? e.target.closest<HTMLButtonElement>("[data-shot-tab]") : null;
    const figure = tab?.closest("[data-shots]");
    if (!tab || !figure) return;
    const index = tab.dataset.shotTab;
    figure.querySelectorAll<HTMLElement>("[data-shot]").forEach((el) => (el.hidden = el.dataset.shot !== index));
    figure.querySelectorAll("[data-shot-tab]").forEach((b) => b.setAttribute("aria-pressed", String(b === tab)));
    const path = figure.querySelector("[data-shot-path]");
    if (path) path.textContent = tab.dataset.path ?? "";
  });
</script>

---
import { Picture } from "astro:assets";
import { projects } from "../lib/data";
import { projectShots } from "../lib/shots";

// Every project as a card with its screenshot: the fastest way to show the work.
// Bystander has no screenshot, so its card shows the award it won instead.
---

<ul class="grid grid-cols-2 gap-3 sm:gap-4" aria-label="Projects">
  {
    projects.map((project, i) => {
      const shot = projectShots[project.id]?.shots[0];
      return (
        <li>
          <a href={`/work/${project.id}`} class="project-card group flex h-full flex-col overflow-hidden rounded-md border border-border bg-paper">
            <div class="aspect-[16/10] overflow-hidden border-b border-border">
              {shot ? (
                <Picture
                  src={shot.src}
                  alt=""
                  widths={[360, 540, 720]}
                  sizes="(min-width: 51rem) 23.5rem, calc(50vw - 2rem)"
                  formats={["avif", "webp"]}
                  loading={i < 2 ? "eager" : "lazy"}
                  class="project-thumb h-full w-full object-cover object-top"
                />
              ) : (
                <div class="dot-grid flex h-full flex-col items-center justify-center gap-2 px-3 text-center">
                  <svg class="h-10 w-9 shrink-0 sm:h-12 sm:w-11" viewBox="0 0 58 64" aria-hidden="true">
                    <path class="fill-teal" d="M16 0h12l-6 26H10z" />
                    <path class="fill-plum" d="M30 0h12l6 26H36z" />
                    <circle class="fill-accent" cx="29" cy="40" r="20" />
                    <path class="fill-paper" d="M29 29l3.2 6.6 7.2 1-5.2 5 1.3 7.2L29 45.4l-6.5 3.4 1.3-7.2-5.2-5 7.2-1z" />
                  </svg>
                  {project.award && (
                    <p class="meta text-[0.6875rem] leading-snug text-muted sm:text-[0.75rem]">
                      <span class="text-ink">{project.award.split(", ")[0]}</span>
                      <br />
                      {project.award.split(", ")[1]}
                    </p>
                  )}
                </div>
              )}
            </div>
            <div class="flex flex-1 flex-col p-3">
              <div class="flex items-baseline justify-between gap-2">
                <span class="font-medium text-ink transition-colors group-hover:text-accent">{project.title}</span>
                {project.year && <span class="meta shrink-0 text-[0.6875rem] tabular-nums text-subtle">{project.year}</span>}
              </div>
              <p class="mt-1 line-clamp-2 text-[0.8125rem] leading-snug text-muted">{project.tagline}</p>
            </div>
          </a>
        </li>
      );
    })
  }
</ul>

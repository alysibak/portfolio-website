---
import { principles, projects } from "../lib/data";
---

<section aria-labelledby="principles-h">
  <h2 id="principles-h" class="meta text-subtle">How I work</h2>
  <ol class="mt-3 grid gap-2 sm:grid-cols-3">
    {
      principles.map((p) => {
        const project = projects.find((proj) => proj.id === p.project)!;
        return (
          <li class="flex flex-col rounded-md border border-border bg-paper p-3.5">
            <p class="text-[0.9375rem] font-medium leading-snug">{p.rule}</p>
            <p class="mt-1.5 flex-1 text-[0.8125rem] leading-snug text-muted">{p.proof}</p>
            <a href={`/work/${project.id}`} class="meta link mt-3 w-fit text-[0.75rem]">
              {project.title} <span aria-hidden="true">→</span>
            </a>
          </li>
        );
      })
    }
  </ol>
</section>

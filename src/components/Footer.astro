---
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../lib/data";

---

<footer class="site-footer border-t border-border px-6 py-6 md:px-8">
  <div class="meta mx-auto flex max-w-xl flex-wrap items-center justify-between gap-x-5 gap-y-2 text-subtle">
    <span class="flex flex-wrap items-center gap-x-5 gap-y-2">
      <span class="inline-flex items-center gap-2">
        <a href={`mailto:${site.email}`} class="link-accent" data-email>{site.email}</a>
        <button
          type="button"
          class="rounded border border-border px-1.5 py-0.5 text-[0.6875rem] text-subtle transition-colors hover:border-accent hover:text-accent"
          data-copy={site.email}
        >
          copy
        </button>
      </span>
      <a href={site.github} target="_blank" rel="noopener noreferrer" class="link">GitHub<span class="sr-only"> (opens in a new tab)</span></a>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="link">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
    </span>
    <span class="flex items-center gap-3">
      {/* My local time, so a visitor in another time zone knows when I'm around. */}
      <span class="hidden text-[0.75rem]" data-local-time data-tz={site.timeZone} title={`Local time in ${site.location}`}>
        <span data-clock></span> my time
      </span>
      <span class="-my-1.5"><ThemeToggle /></span>
    </span>
  </div>
</footer>

<script>
  // Copy buttons: email links often do nothing on phones or without a mail app.
  document.addEventListener("click", async (e) => {
    const btn = e.target instanceof Element ? e.target.closest<HTMLButtonElement>("[data-copy]") : null;
    if (!btn) return;
    const label = btn.textContent;
    try {
      await navigator.clipboard.writeText(btn.dataset.copy ?? "");
      btn.textContent = "copied";
    } catch {
      // No clipboard access: select the address so a long-press or Ctrl+C works.
      const target = btn.parentElement?.querySelector("[data-email]");
      if (target) window.getSelection()?.selectAllChildren(target);
      btn.textContent = "selected";
    }
    setTimeout(() => (btn.textContent = label), 1600);
  });

  // "Seeking Winter 2027" goes stale once that term starts. Hide it rather
  // than show an out-of-date claim; the content check also flags it at build.
  function expire() {
    const now = new Date();
    document.querySelectorAll<HTMLElement>("[data-expires]").forEach((el) => {
      if (now >= new Date(`${el.dataset.expires}-01T00:00:00`)) el.classList.add("hidden");
    });
  }
  document.addEventListener("astro:page-load", expire);

  // My local time, refreshed every half minute.
  function localTime() {
    const local = document.querySelector<HTMLElement>("[data-local-time]");
    const clock = local?.querySelector("[data-clock]");
    if (local && clock) {
      try {
        clock.textContent = new Intl.DateTimeFormat("en-CA", {
          hour: "numeric",
          minute: "2-digit",
          timeZone: local.dataset.tz,
        }).format(new Date());
        local.classList.remove("hidden");
      } catch {
        // An unknown time zone: leave the clock out.
      }
    }
  }
  document.addEventListener("astro:page-load", localTime);
  setInterval(localTime, 30_000);
</script>

---
interface Props {
  variant?: "home" | "work" | "page";
}

const { variant = "page" } = Astro.props;

// Keyboard users get the shortcut; touch screens get a button, since there is
// no / or ~ to press. Both open the same console via [data-open-console].
---

<div
  class:list={[
    "shell-hint",
    variant === "home" && "mt-8",
    (variant === "work" || variant === "page") && "mt-5",
  ]}
>
  {
    variant === "work" ? (
      <p>
        Every case study is also in the shell.{" "}
        <span class="hint-keys">
          Press <button type="button" class="shell-kbd" data-open-console>/</button> and run
        </span>
        <span class="hint-touch">
          <button type="button" class="hint-open" data-open-console>Open it</button> and run
        </span>{" "}
        <span class="text-accent">cat bystander</span>.
      </p>
    ) : variant === "home" ? (
      <p>
        This site has an interactive shell.{" "}
        <span class="hint-keys">
          Press <button type="button" class="shell-kbd" data-open-console>/</button> or{" "}
          <button type="button" class="shell-kbd" data-open-console>~</button> to open it,
        </span>
        <span class="hint-touch">
          <button type="button" class="hint-open" data-open-console>Open it</button>,
        </span>{" "}
        then try <span class="text-accent">help</span> or <span class="text-accent">cat carinfo</span>.
      </p>
    ) : (
      <p>
        <span class="hint-keys">
          Press <button type="button" class="shell-kbd" data-open-console>/</button> or{" "}
          <button type="button" class="shell-kbd" data-open-console>~</button> to open the shell.
        </span>
        <span class="hint-touch">
          <button type="button" class="hint-open" data-open-console>Open the shell</button>.
        </span>{" "}
        Try <span class="text-accent">git log</span> or <span class="text-accent">whoami</span>.
      </p>
    )
  }
</div>

---
import type { Stat } from "../lib/data";

interface Props {
  stats: Stat[];
  /** Columns from the sm breakpoint up. Phones get two, or three when asked for three. */
  columns?: 3 | 4;
}

const { stats, columns = 4 } = Astro.props;
---

<ul class:list={["grid gap-2", columns === 4 ? "grid-cols-2 sm:grid-cols-4" : "grid-cols-3"]}>
  {
    stats.map((stat) => (
      <li class="rounded-md border border-border bg-paper px-3 py-3.5">
        <span
          class="block whitespace-nowrap font-mono text-[1.375rem] font-medium leading-none tracking-tight tabular-nums sm:text-[1.5rem]"
          data-count={stat.value}
          data-suffix={stat.suffix ?? ""}
        >
          {stat.value.toLocaleString("en-US")}
          {stat.suffix}
        </span>
        <span class="mt-2 block text-[0.8125rem] leading-snug text-muted">{stat.label}</span>
      </li>
    ))
  }
</ul>

<script>
  // Counts each number up once per page view. The final value is already in
  // the markup, so nothing depends on this running.
  function countUp() {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    document.querySelectorAll<HTMLElement>("[data-count]").forEach((el) => {
      const target = Number(el.dataset.count);
      const suffix = el.dataset.suffix ?? "";
      const start = performance.now();
      const tick = (now: number) => {
        const p = Math.min(1, (now - start) / 900);
        const eased = 1 - (1 - p) ** 3;
        el.textContent = Math.round(target * eased).toLocaleString("en-US") + suffix;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }
  document.addEventListener("astro:page-load", countUp);
</script>

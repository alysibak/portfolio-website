---
import ThemeToggle from "./ThemeToggle.astro";
import { navLinks, site } from "../lib/data";
import { publishedPosts } from "../lib/bug-log";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
// bug.log joins the nav once there's something published in it.
const links = [...navLinks, ...((await publishedPosts()).length ? [{ label: "bug.log", href: "/bug-log" }] : [])];

// The page's path as a shell working directory: ~/work/carinfo, each part a link.
const parts = pathname === "/" ? [] : pathname.slice(1).split("/");
const crumbs = parts.map((part, i) => ({ part, href: `/${parts.slice(0, i + 1).join("/")}` }));
---

<header class="site-header border-b border-border px-6 py-4 md:px-8">
  <div class="mx-auto flex max-w-xl items-center justify-between">
    <div class="flex min-w-0 items-baseline gap-2">
      <a href="/" class="inline-block text-base font-medium text-ink" transition:name="site-name">{site.name.split(" ")[0]}</a>
      <span class="meta hidden min-w-0 truncate text-subtle md:block" aria-hidden="true">
        <a href="/" class="hover:text-accent" tabindex="-1">~</a>{crumbs.map((c) => <>/<a href={c.href} class="hover:text-accent" tabindex="-1">{c.part}</a></>)}
      </span>
    </div>
    <nav aria-label="Primary" class="meta flex items-center gap-4 md:gap-5">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={pathname === link.href ? "page" : undefined}
            class:list={[
              "transition-colors hover:text-ink",
              pathname === link.href ? "text-ink" : "text-muted",
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <button
        type="button"
        class="hidden items-center gap-1.5 text-subtle transition-colors hover:text-accent sm:inline-flex"
        data-open-palette
      >
        search <kbd class="shell-kbd text-[0.6875rem]">^K</kbd>
      </button>
      <ThemeToggle />
    </nav>
  </div>
</header>

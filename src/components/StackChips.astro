---
interface Props {
  stack: string[];
  /** What the list is, for screen readers. */
  label?: string;
}

const { stack, label = "Stack" } = Astro.props;
---

<ul class="stack-list meta flex flex-wrap text-[0.75rem] text-muted" aria-label={label}>
  {stack.map((tech) => <li>{tech.toLowerCase()}</li>)}
</ul>
